# ---- storage ---------------------------------------------------------------
CLIF_DATA_DIR=./data

# ---- languages ---------------------------------------------------------------
# Language code -> ordered language refset IDs (first decides the preferred term).
# Languages without an entry index all active descriptions with that language code.
# German example for a national edition: {"en": [...], "de": ["<German language refset id>"]}
CLIF_LANGUAGE_REFSETS={"en": ["900000000000509007", "900000000000508004"]}
CLIF_INDEX_LANGUAGES=[]
CLIF_DEFAULT_DISPLAY_LANGUAGE=en
CLIF_FALLBACK_LANGUAGES=["en"]

# ---- retrieval -----------------------------------------------------------------
CLIF_CANDIDATE_COUNT=32
CLIF_DESCRIPTION_POOL=200
CLIF_WEIGHTS__LEXICAL=0.40
CLIF_WEIGHTS__SEMANTIC=0.35
CLIF_WEIGHTS__EXACT=0.15
CLIF_WEIGHTS__PRIOR=0.10
CLIF_CATEGORY_WEIGHT=0.15

# ---- vector retrieval ------------------------------------------------------------
# none | hashing | sentence-transformers | http
CLIF_EMBEDDER=hashing
# sentence-transformers: local model directory (mount it into /data), e.g. multilingual-e5-small
# CLIF_EMBEDDER=sentence-transformers
# CLIF_EMBEDDER_MODEL=/data/models/multilingual-e5-small
# CLIF_EMBEDDER_QUERY_PREFIX="query: "
# CLIF_EMBEDDER_PASSAGE_PREFIX="passage: "
# http: OpenAI-compatible embeddings endpoint inside the hospital network
# CLIF_EMBEDDER=http
# CLIF_EMBEDDER_URL=http://embeddings:8080/v1/embeddings
# CLIF_EMBEDDER_MODEL=intfloat/multilingual-e5-small

# ---- clinical context --------------------------------------------------------------
# off | fixed_expressions | prefer
CLIF_SITUATION_MODE=fixed_expressions
CLIF_ABBREVIATION_DOMINANCE=0.9

# ---- reranker ------------------------------------------------------------------------
# heuristic | laya | laya-local | llm
CLIF_RERANKER=heuristic
CLIF_RERANKER_FALLBACK=none
CLIF_RERANK_CANDIDATES=20
CLIF_RERANKER_TIMEOUT_S=20

# Laya over HTTP (docker compose --profile laya up -d)
CLIF_LAYA_URL=http://laya:8000
CLIF_LAYA_API_KEY=
# "" = by source language (english / multilingual)
CLIF_LAYA_MODEL=
# laya-local: path to a fine-tuned checkpoint (build with CLIF_EXTRAS=laya)
CLIF_LAYA_CHECKPOINT=
CLIF_LAYA_HEAD_MAX_LEN_MIN=256
CLIF_LAYA_HEAD_MAX_LEN_MAX=1024

# Local LLM (vLLM, llama.cpp server, Ollama ...), OpenAI-compatible
CLIF_LLM_URL=
CLIF_LLM_MODEL=

# ---- decision ----------------------------------------------------------------------------
# Replace with values from `clif evaluate <validation set> --calibrate /data/calibration.json`
CLIF_THRESHOLD_MATCH=0.60
CLIF_THRESHOLD_MARGIN=0.20
CLIF_THRESHOLD_NO_MATCH=0.30
CLIF_CALIBRATION_FILE=

# ---- docker ------------------------------------------------------------------------------
CLIF_BIND_ADDRESS=127.0.0.1
CLIF_PORT=8000
CLIF_EXTRAS=
LAYA_DEVICE=cpu
LAYA_TORCH_INDEX=cpu
HF_HUB_OFFLINE=0
